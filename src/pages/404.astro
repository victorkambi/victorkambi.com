---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found — Victor Kambi" description="This page could not be found.">
  <section class="missing"><p class="eyebrow">404</p><h1>This page isn’t here.</h1><a href="/">Return to the work index ↗</a></section>
</SiteLayout>
<style>.missing{padding-block:8rem}.eyebrow{color:var(--color-muted)}h1{font:400 clamp(2.5rem,7vw,5rem)/1 var(--font-display);letter-spacing:-.05em}.missing a{color:var(--color-accent)}</style>
