---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const experiments = await getCollection('lab');
---
<SiteLayout active="home">
  <section class="hero" aria-labelledby="intro-title">
    <p class="eyebrow">Computer scientist · Product designer-engineer · CTO at Tajji Ltd.</p>
    <h1 id="intro-title">I design the details.<br /><em>Then I build the product.</em></h1>
    <p class="lede">I’m Victor, a computer scientist and product designer-engineer. At Tajji, I help design and build BomaOS and Jirani, products now live on Google Play.</p>
    <a class="text-link" href="/about">A little about me <span aria-hidden="true">↗</span></a>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="section-head"><div><p class="eyebrow">Selected work</p><h2 id="work-title">Products, systems, and visual work</h2></div><p class="section-note">A small index of shipped work and studies.</p></div>
    <div class="controls">
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        <button type="button" data-filter="product" aria-pressed="false">Product</button>
        <button type="button" data-filter="visual" aria-pressed="false">Visual</button>
        <button type="button" data-filter="lab" aria-pressed="false">Lab</button>
      </div>
      <div class="views" role="group" aria-label="Project layout">
        <button type="button" data-view="index" aria-pressed="true">Index</button>
        <button type="button" data-view="gallery" aria-pressed="false">Gallery</button>
      </div>
    </div>
    <div class="project-index" data-project-list>
      {projects.map((project, index) => <a class="project-row" href={`/work/${project.data.slug}`} data-kind={project.data.kind} data-project-item>
        <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="project-main"><span class="project-title">{project.data.title}</span><span class="project-line">{project.data.oneLiner}</span></span>
        <span class="project-tags">{project.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</span>
        <span class="project-year">{project.data.year}</span>
      </a>)}
      {experiments.map((experiment, index) => <a class="project-row lab-row" href={`/lab/${experiment.data.slug}`} data-kind="lab" data-project-item hidden>
        <span class="project-number">L{String(index + 1).padStart(2, '0')}</span><span class="project-main"><span class="project-title">{experiment.data.title}</span><span class="project-line">{experiment.data.summary}</span></span><span class="project-tags"><span>Lab</span></span><span class="project-year">{experiment.data.year}</span>
      </a>)}
    </div>
    <div class="project-gallery" data-project-gallery>
      {projects.map((project) => <a class="gallery-card" href={`/work/${project.data.slug}`} data-kind={project.data.kind} data-project-item>
        <Image src={project.data.cover} alt="" width={project.data.cover.width} height={project.data.cover.height} loading="lazy" />
        <span class="gallery-caption"><span>{project.data.title}</span><span>{project.data.year}</span></span>
      </a>)}
      {experiments.map((experiment) => <a class="gallery-card lab-row" href={`/lab/${experiment.data.slug}`} data-kind="lab" data-project-item hidden>
        <span class="lab-art" aria-hidden="true">{experiment.data.title.slice(0, 1)}</span><span class="gallery-caption"><span>{experiment.data.title}</span><span>{experiment.data.year}</span></span>
      </a>)}
    </div>
    <p class="empty-state" data-empty hidden>No projects in this filter yet.</p>
  </section>

  <section class="lab-teaser"><div><p class="eyebrow">Playground</p><h2>Small questions, made interactive.</h2><p>Interface studies and experiments live in the lab.</p></div><a class="text-link" href="/lab">Visit the lab <span aria-hidden="true">↗</span></a></section>
  <section class="contact" id="contact"><p class="eyebrow">Have a project in mind?</p><h2>Let’s make something useful.</h2><a href="mailto:work@victorkambi.com">work@victorkambi.com <span aria-hidden="true">↗</span></a></section>
</SiteLayout>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-project-item]')];
  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  const index = document.querySelector<HTMLElement>('[data-project-list]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const views = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')];
  function setFilter(kind: string, updateUrl: boolean) {
    filters.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === kind)));
    let visible = 0;
    items.forEach((item) => { const show = kind === 'all' || item.dataset.kind === kind; item.hidden = !show; if (show) visible++; });
    if (empty) empty.hidden = visible > 0;
    if (updateUrl) { const url = new URL(location.href); if (kind === 'all') url.searchParams.delete('kind'); else url.searchParams.set('kind', kind); history.pushState(null, '', url); }
  }
  function setView(view: string) {
    gallery?.classList.toggle('active', view === 'gallery');
    index?.classList.toggle('active', view === 'index');
    views.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
  }
  filters.forEach((button) => button.addEventListener('click', () => setFilter(button.dataset.filter ?? 'all', true)));
  views.forEach((button) => button.addEventListener('click', () => setView(button.dataset.view ?? 'index')));
  window.addEventListener('popstate', () => {
    const current = new URL(location.href).searchParams.get('kind');
    setFilter(current && ['product', 'visual', 'lab'].includes(current) ? current : 'all', false);
  });
  const initial = new URL(location.href).searchParams.get('kind');
  if (initial && ['product', 'visual', 'lab'].includes(initial)) setFilter(initial, false);
  setView('index');
</script>

<style>
  .hero { padding-block: clamp(4rem, 10vw, 9rem) clamp(4rem, 8vw, 7rem); max-width: 64rem; }
  .eyebrow { margin:0 0 .8rem; color:var(--color-muted); font-size:var(--text-xs); letter-spacing:.1em; text-transform:uppercase; font-weight:650; }
  h1,h2,p { margin-top:0; }
  h1 { margin-bottom:1.5rem; font:400 var(--text-display)/.98 var(--font-display); letter-spacing:-.065em; }
  h1 em { color:var(--color-accent); font-style:normal; }
  .lede { max-width:47rem; margin-bottom:1rem; color:var(--color-muted); font-size:clamp(1.05rem, 1.6vw, 1.25rem); }
  .text-link { display:inline-flex; gap:.5rem; font-size:var(--text-sm); font-weight:650; text-decoration-thickness:1px; }
  .section-head { display:flex; justify-content:space-between; align-items:end; gap:2rem; border-bottom:1px solid var(--color-line); padding-bottom:1.2rem; }
  .section-head h2,.lab-teaser h2,.contact h2 { margin:0; font:400 var(--text-lg)/1.2 var(--font-display); letter-spacing:-.035em; }
  .section-note { max-width:19rem; margin:0; color:var(--color-muted); font-size:var(--text-sm); }
  .controls { display:flex; justify-content:space-between; align-items:center; padding-block:1rem; gap:1rem; }
  .filters,.views { display:flex; gap:.35rem; }
  .filters button,.views button { border:1px solid transparent; border-radius:99px; padding:.42rem .75rem; background:transparent; color:var(--color-muted); font:inherit; font-size:var(--text-sm); cursor:pointer; }
  .filters button[aria-pressed="true"],.views button[aria-pressed="true"] { border-color:var(--color-line); background:var(--color-surface); color:var(--color-text); }
  .project-index { display:block; }
  .project-index:not(.active) { display:none; }
  .project-row { display:grid; grid-template-columns:3.5rem minmax(0,1fr) minmax(9rem, .32fr) 3.5rem; gap:1rem; align-items:center; padding:1.25rem .5rem; border-top:1px solid var(--color-line); text-decoration:none; }
  .project-row:hover { background:var(--color-surface); }
  .project-number,.project-year,.project-tags { color:var(--color-muted); font-size:var(--text-sm); font-variant-numeric:tabular-nums; }
  .project-main { display:grid; gap:.2rem; }
  .project-title { font-size:1.06rem; font-weight:600; letter-spacing:-.02em; }
  .project-line { color:var(--color-muted); font-size:var(--text-sm); }
  .project-tags { display:flex; gap:.4rem; flex-wrap:wrap; }
  .project-tags span { border:1px solid var(--color-line); padding:.15rem .4rem; border-radius:99px; font-size:.68rem; }
  .project-year { text-align:right; }
  .project-gallery { display:none; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1rem; }
  .project-gallery.active { display:grid; }
  .gallery-card { background:var(--color-surface); border:1px solid var(--color-line); border-radius:var(--radius-md); overflow:hidden; text-decoration:none; }
  .gallery-card img,.lab-art { display:block; width:100%; aspect-ratio:1.58; object-fit:cover; background:var(--color-line); }
  .lab-art { display:grid; place-items:center; color:var(--color-accent); font:400 7rem var(--font-display); }
  .gallery-caption { display:flex; justify-content:space-between; padding:.8rem; gap:1rem; font-size:var(--text-sm); }
  .gallery-caption span:last-child { color:var(--color-muted); }
  .empty-state { padding:2rem 0; color:var(--color-muted); }
  .lab-teaser { margin-top:var(--space-6); padding-block:2rem; border-top:1px solid var(--color-line); border-bottom:1px solid var(--color-line); display:flex; align-items:end; justify-content:space-between; gap:2rem; }
  .lab-teaser p:not(.eyebrow) { color:var(--color-muted); margin:.8rem 0 0; }
  .contact { padding-block:var(--space-6) 1rem; }
  .contact h2 { margin-bottom:1rem; }
  .contact > a { color:var(--color-accent); font-size:1.1rem; font-weight:600; }
  @media(max-width: 42rem) { .section-head { align-items:start; flex-direction:column; gap:.8rem; } .project-row { grid-template-columns:2rem minmax(0,1fr) 3rem; gap:.6rem; } .project-tags { display:none; } .project-gallery { grid-template-columns:1fr; } .controls { align-items:start; flex-direction:column; } .lab-teaser { align-items:start; flex-direction:column; } }
</style>
