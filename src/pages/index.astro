<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  // Start in whichever mode the system is currently in
  root.classList.add(media.matches ? 'dark' : 'light');

  // Keep following the system, unless the visitor has clicked the toggle
  let manualOverride = false;
  media.addEventListener('change', (e) => {
    if (manualOverride) return;
    root.classList.remove('dark', 'light');
    root.classList.add(e.matches ? 'dark' : 'light');
  });

  toggle.addEventListener('click', () => {
    manualOverride = true;
    root.classList.toggle('dark');
    root.classList.toggle('light');
  });

  // Gavin-style hover highlight: a box that glides between list rows
  document.querySelectorAll('.hover-list').forEach((container) => {
    const highlight = document.createElement('div');
    highlight.className = 'hover-highlight';
    container.prepend(highlight);

    const rows = container.querySelectorAll('.row');

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        highlight.style.width = row.offsetWidth + 'px';
        highlight.style.height = row.offsetHeight + 'px';
        highlight.style.transform = `translate(${row.offsetLeft}px, ${row.offsetTop}px)`;
        highlight.style.opacity = '1';
      });
    });

    container.addEventListener('mouseleave', () => {
      highlight.style.opacity = '0';
    });
  });

  // Tabbed nav: one panel visible at a time.
  // Current panel drifts back and blurs out of focus, then the new panel
  // arrives blurred and sharpens into focus — a camera-style focus pull.
  const navLinks = document.querySelectorAll('nav.site a[data-tab]');
  const panels = document.querySelectorAll('.tab-panel');
  const EXIT_MS = 380;
  let switching = false;

  function showPanel(targetId) {
    panels.forEach((panel) => {
      panel.classList.remove('focus-out', 'focus-in');
      if (panel.id === targetId) {
        panel.classList.remove('hidden-panel');
        void panel.offsetWidth; // restart animation
        panel.classList.add('focus-in');
      } else {
        panel.classList.add('hidden-panel');
      }
    });
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.dataset.tab;
      if (switching || link.classList.contains('active')) return;

      const current = document.querySelector('.tab-panel:not(.hidden-panel)');
      switching = true;
      navLinks.forEach((l) => l.classList.toggle('active', l === link));

      if (current) {
        current.classList.add('focus-out');
        setTimeout(() => {
          showPanel(targetId);
          switching = false;
        }, EXIT_MS);
      } else {
        showPanel(targetId);
        switching = false;
      }
    });
  });
  // Live clock — Victor's local time, Africa/Nairobi (UTC+3)
  const timeEl = document.getElementById('local-time');
  const clockFormatter = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Africa/Nairobi',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  });
  function updateClock() {
    timeEl.textContent = `${clockFormatter.format(new Date())} UTC-3`;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>

