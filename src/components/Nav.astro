---
---
<nav class="site">
  <a data-tab="work" class="active">Work</a>
  <a data-tab="about">About</a>
  <span class="spacer"></span>
  <button id="theme-toggle" aria-label="Toggle dark mode"></button>
</nav>

<style>
  nav.site {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0 0 1.5rem;
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 2rem;
    letter-spacing: -0.01em;
  }
  nav.site a {
    color: var(--accent);
    opacity: 1;
    transition: opacity .15s ease;
    cursor: pointer;
  }
  nav.site a:hover {
    opacity: 0.75;
  }
  nav.site a.active {
    /* Black or white, whichever has the stronger WCAG contrast
       against the current experience background. */
    color: var(--nav-active, var(--text));
    opacity: 1;
  }
  nav.site .spacer {
    flex: 1;
  }
  #theme-toggle {
    display: none;
    background: none;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    width: 2.375rem;
    height: 1.3125rem;
    position: relative;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }
  #theme-toggle::after {
    content: '';
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: 50%;
    background: var(--accent);
    transition: transform .2s ease;
  }
  html.dark #theme-toggle::after {
    transform: translateX(1.0625rem);
  }
</style>