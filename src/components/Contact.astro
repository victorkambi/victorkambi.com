<section id="contact" class="tab-panel hidden-panel hover-list">
  <a class="row" href="mailto:work@victorkambi.com">
    <div class="title">Email</div>
    <div class="year">work@victorkambi.com</div>
  </a>
  <a class="row" href="https://github.com/victorkambi" target="_blank" rel="noopener">
    <div class="title">GitHub</div>
    <div class="year">github.com/victorkambi</div>
  </a>
  <a class="row" href="https://victorkambi.com" target="_blank" rel="noopener">
    <div class="title">Portfolio</div>
    <div class="year">victorkambi.com</div>
  </a>
</section>

<style>
  .tab-panel {
    padding: 1.25rem 0 0;
  }
  .tab-panel.hidden-panel {
    display: none;
  }
  .tab-panel.focus-out {
    animation: focusOut .38s cubic-bezier(.45, 0, .4, 1) forwards;
  }
  .tab-panel.focus-in {
    animation: focusIn .65s cubic-bezier(.19, 1, .22, 1);
  }
  @keyframes focusOut {
    from {
      opacity: 1;
      filter: blur(0);
      transform: scale(1) translateY(0);
    }
    to {
      opacity: 0;
      filter: blur(5px);
      transform: scale(0.985) translateY(-0.25rem);
    }
  }
  @keyframes focusIn {
    from {
      opacity: 0;
      filter: blur(5px);
      transform: scale(0.985) translateY(0.25rem);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1) translateY(0);
    }
  }
  #contact {
    padding-bottom: 3.5rem;
  }
  .hover-list {
    position: relative;
  }
  .hover-list :global(.hover-highlight) {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    background: color-mix(in srgb, var(--accent-soft), var(--bg-elevated));
    border-radius: 0.875rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, .10), 0 1px 3px rgba(0, 0, 0, .08);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: transform .55s cubic-bezier(.34, 1.56, .64, 1), width .55s cubic-bezier(.34, 1.56, .64, 1), height .55s cubic-bezier(.34, 1.56, .64, 1), opacity .2s ease;
  }
  html.dark .hover-list :global(.hover-highlight) {
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .08), 0 4px 18px rgba(0, 0, 0, .55);
  }
  .row {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: 1rem;
    padding: 0.875rem 0.75rem;
    margin: 0 -0.75rem;
  }
  a.row {
    cursor: pointer;
  }
  .row .title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text);
    transition: color .15s ease;
  }
  .row .year {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  #contact .row:hover .title {
    color: var(--accent);
  }
</style>