---
import '../styles/tokens.css';
const { title = 'Victor Kambi — Design and Engineering', description = 'Victor Kambi is a computer scientist and product designer-engineer who designs and builds digital products.', active = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const workSlug = Astro.url.pathname.match(/^\/work\/([^/]+)/)?.[1];
const socialImage = new URL(workSlug ? `/og/${workSlug}.svg` : '/og/default.svg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Victor Kambi', url: 'https://victorkambi.com', jobTitle: 'Product designer-engineer', description: 'A computer scientist who designs and builds digital products.' })} />
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
    </script>
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html { background: var(--color-bg); scroll-behavior: smooth; }
      body { margin: 0; color: var(--color-text); background: var(--color-bg); font: 400 var(--text-md)/1.55 var(--font-body); -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-underline-offset: .2em; }
      a:hover { color: var(--color-accent); }
      :focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
      .shell { width: min(100% - 3rem, 76rem); margin-inline: auto; }
      .topbar { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding-block:1.35rem; border-bottom:1px solid var(--color-line); font-size:var(--text-sm); }
      .brand { text-decoration:none; font-weight:650; letter-spacing:-.03em; }
      .nav { display:flex; align-items:center; gap:clamp(.8rem, 2.5vw, 2rem); }
      .nav a { text-decoration:none; color:var(--color-muted); }
      .nav a[aria-current="page"] { color:var(--color-text); }
      .theme-toggle { color:var(--color-text); background:transparent; border:1px solid var(--color-line); border-radius:99px; padding:.35rem .65rem; font:inherit; cursor:pointer; }
      .footer { margin-top:var(--space-6); padding-block:1.5rem 2.5rem; border-top:1px solid var(--color-line); color:var(--color-muted); font-size:var(--text-sm); display:flex; justify-content:space-between; gap:1rem; }
      @media (max-width: 40rem) { .shell { width:min(100% - 2rem, 76rem); } .topbar { align-items:flex-start; flex-wrap:wrap; gap:.7rem; } .nav { width:100%; justify-content:space-between; gap:.5rem; } .footer { flex-direction:column; } }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior:auto !important; animation-duration:.01ms !important; transition-duration:.01ms !important; } }
    </style>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const initialTheme = document.documentElement.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      themeButton?.setAttribute('aria-pressed', String(initialTheme === 'dark'));
      document.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-theme-toggle]');
        if (!button) return;
        const current = document.documentElement.dataset.theme ?? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        button.setAttribute('aria-pressed', String(next === 'dark'));
      });
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href="/">Victor Kambi<span aria-hidden="true">.</span></a>
        <nav class="nav" aria-label="Main navigation">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>Work</a>
          <a href="/lab" aria-current={active === 'lab' ? 'page' : undefined}>Lab</a>
          <a href="/about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
          <a href="/writing" hidden>Writing</a>
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme" aria-pressed="false">◐ Theme</button>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="footer"><span>Victor Kambi · Nairobi, Kenya</span><span>© {new Date().getFullYear()}</span></footer>
    </div>
  </body>
</html>
