---
import PortfolioScript from '../components/PortfolioScript.astro';
const { title = 'Victor Kambi — Design & Engineering', description = 'Portfolio of Victor Kambi, Design & Engineering — building backend systems and design systems in Kenya.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #FFFFFF;
        --bg-elevated: #FFFFFF;
        --text: #000000;
        --text-muted: rgba(0, 0, 0, .55);
        --border: rgba(0, 0, 0, .12);
        --accent: rgba(0, 0, 0, .5);
        --accent-soft: rgba(0, 0, 0, .08);
        --font-sans: 'Inter', system-ui, sans-serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #000000;
          --bg-elevated: #1E1E1E;
          --text: #FFFFFF;
          --text-muted: rgba(255, 255, 255, .55);
          --border: rgba(255, 255, 255, .14);
          --accent: rgba(255, 255, 255, .5);
          --accent-soft: rgba(255, 255, 255, .08);
        }
      }
      html.dark {
        --bg: #000000;
        --bg-elevated: #1E1E1E;
        --text: #FFFFFF;
        --text-muted: rgba(255, 255, 255, .55);
        --border: rgba(255, 255, 255, .14);
        --accent: rgba(255, 255, 255, .5);
        --accent-soft: rgba(255, 255, 255, .08);
      }
      html.light {
        --bg: #FFFFFF;
        --bg-elevated: #FFFFFF;
        --text: #000000;
        --text-muted: rgba(0, 0, 0, .55);
        --border: rgba(0, 0, 0, .12);
        --accent: rgba(0, 0, 0, .5);
        --accent-soft: rgba(0, 0, 0, .08);
      }
      /* Per-experience palettes: the active nav tab retints the whole
         site (bg, text, borders, accents). Work is Platinum (#D9D9D9),
         About is Strawberry (#FA5053). Dark mode uses the same palettes.
         Specificity note: these must come after html.dark / html.light,
         and every dark rule needs the html.dark[...] form to beat them. */
      html[data-experience='work'] {
        --bg: #D9D9D9;
        --bg-elevated: #E8E8E8;
        --text: #171719;
        --text-muted: rgba(23, 23, 25, .55);
        --border: rgba(23, 23, 25, .16);
        --accent: rgba(23, 23, 25, .5);
        --accent-soft: rgba(23, 23, 25, .08);
        --nav-active: #000000;
      }
      html[data-experience='about'] {
        --bg: #F9D2D4;
        --bg-elevated: #FFF1F1;
        --text: #2A0407;
        --text-muted: rgba(42, 4, 7, .6);
        --border: rgba(42, 4, 7, .16);
        --accent: #FF3B3F;
        --accent-soft: rgba(255, 59, 63, .22);
        --nav-active: #000000;
      }
      html.dark[data-experience='work'] {
        --bg: #D9D9D9;
        --bg-elevated: #E8E8E8;
        --text: #171719;
        --text-muted: rgba(23, 23, 25, .55);
        --border: rgba(23, 23, 25, .16);
        --accent: rgba(23, 23, 25, .5);
        --accent-soft: rgba(23, 23, 25, .08);
        --nav-active: #000000;
      }
      html.dark[data-experience='about'] {
        --bg: #F9D2D4;
        --bg-elevated: #FFF1F1;
        --text: #2A0407;
        --text-muted: rgba(42, 4, 7, .6);
        --border: rgba(42, 4, 7, .16);
        --accent: #FF3B3F;
        --accent-soft: rgba(255, 59, 63, .22);
        --nav-active: #000000;
      }
      /* Wide-gamut layer: same palettes authored in display-p3. */
      @supports (color: color(display-p3 1 0 0)) {
        html[data-experience='work'] {
          --bg: color(display-p3 0.851 0.851 0.851);
          --bg-elevated: color(display-p3 0.91 0.91 0.91);
          --text: color(display-p3 0.09 0.09 0.098);
          --text-muted: color(display-p3 0.09 0.09 0.098 / .55);
          --border: color(display-p3 0.09 0.09 0.098 / .16);
          --accent: color(display-p3 0.09 0.09 0.098 / .5);
          --accent-soft: color(display-p3 0.09 0.09 0.098 / .08);
          --nav-active: #000000;
        }
        html[data-experience='about'] {
          --bg: color(display-p3 0.976 0.824 0.831);
          --bg-elevated: color(display-p3 1 0.945 0.945);
          --text: color(display-p3 0.165 0.016 0.027);
          --text-muted: color(display-p3 0.165 0.016 0.027 / .6);
          --border: color(display-p3 0.165 0.016 0.027 / .16);
          --accent: color(display-p3 1 0.231 0.247);
          --accent-soft: color(display-p3 1 0.231 0.247 / .22);
          --nav-active: #000000;
        }
        html.dark[data-experience='work'] {
          --bg: color(display-p3 0.851 0.851 0.851);
          --bg-elevated: color(display-p3 0.91 0.91 0.91);
          --text: color(display-p3 0.09 0.09 0.098);
          --text-muted: color(display-p3 0.09 0.09 0.098 / .55);
          --border: color(display-p3 0.09 0.09 0.098 / .16);
          --accent: color(display-p3 0.09 0.09 0.098 / .5);
          --accent-soft: color(display-p3 0.09 0.09 0.098 / .08);
          --nav-active: #000000;
        }
        html.dark[data-experience='about'] {
          --bg: color(display-p3 0.976 0.824 0.831);
          --bg-elevated: color(display-p3 1 0.945 0.945);
          --text: color(display-p3 0.165 0.016 0.027);
          --text-muted: color(display-p3 0.165 0.016 0.027 / .6);
          --border: color(display-p3 0.165 0.016 0.027 / .16);
          --accent: color(display-p3 1 0.231 0.247);
          --accent-soft: color(display-p3 1 0.231 0.247 / .22);
          --nav-active: #000000;
        }
      }
      * {
        box-sizing: border-box;
      }
      html {
        font-size: 16px;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        font-weight: 400;
        font-size: 1rem;
        line-height: 1.6;
        transition: background .25s ease, color .25s ease;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      ::selection {
        background: var(--accent-soft);
        color: var(--accent);
      }
      .wrap {
        max-width: 36.25rem;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
          animation: none !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
    <PortfolioScript />
  </body>
</html>